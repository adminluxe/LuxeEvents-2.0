import React, { useRef } from "react";

export function HaloButton({ as = "button", className = "", children, ...props }) {
  const ref = useRef(null);
  const Comp = as;

  const onMouseMove = (e) => {
    const el = ref.current;
    if (!el) return;
    const rect = el.getBoundingClientRect();
    const x = e.clientX - rect.left; const y = e.clientY - rect.top;
    el.style.setProperty("--mx", `${x}px`);
    el.style.setProperty("--my", `${y}px`);
  };

  return (
    <Comp
      ref={ref}
      onMouseMove={onMouseMove}
      className={[
        "relative isolate overflow-hidden transition-shadow",
        "before:absolute before:inset-0 before:opacity-0 before:transition-opacity",
        "after:absolute after:size-[180px] after:rounded-full after:opacity-0 after:blur-2xl after:transition-opacity",
        "before:bg-[radial-gradient(120px_120px_at_var(--mx)_var(--my),rgba(255,255,255,0.25),transparent_60%)]",
        "after:translate-x-[-50%] after:translate-y-[-50%] after:top-[var(--my)] after:left-[var(--mx)] after:bg-yellow-400/30",
        "hover:shadow-[0_0_40px_rgba(234,179,8,0.35)] hover:before:opacity-100 hover:after:opacity-100",
        className
      ].join(" ")}
      {...props}
    >
      {children}
    </Comp>
  );
}
export default HaloButton;
