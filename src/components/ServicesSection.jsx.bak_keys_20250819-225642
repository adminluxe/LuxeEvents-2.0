import React from "react";
import { LUXE_SERVICES } from "../data/services.luxe";

function Badge({children}) {
  return (
    <span className="px-2 py-1 rounded-full bg-white/10 text-white text-[11px] tracking-wider uppercase ring-1 ring-white/15">
      {children}
    </span>
  );
}

export default function ServicesSection({ lang = (localStorage.getItem("lang")||"fr") }) {
  const isEN = String(lang).startsWith("en");
  return (
    <section id="services" className="py-12 sm:py-20">
      <div className="container mx-auto px-4">
        <header className="mb-8 sm:mb-12">
          <h2 className="text-3xl sm:text-4xl font-serif text-white">
            {isEN ? "Our Services" : "Nos Services"}
          </h2>
          <p className="text-white/70 mt-2">
            {isEN
              ? "Tailor-made experiences with our signature art direction."
              : "Des expériences sur-mesure, signées par notre direction artistique."}
          </p>
        </header>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {LUXE_SERVICES.map(s => (
            <article key={s.id}
              className="group relative overflow-hidden rounded-2xl shadow-lg ring-1 ring-white/10 bg-black/40"
              style={{backgroundImage:`url(${s.img})`, backgroundSize:"cover", backgroundPosition:"center"}}
            >
              <div className="absolute inset-0 bg-gradient-to-t from-black/70 via-black/35 to-transparent"/>
              <div className="relative p-6 sm:p-8 flex flex-col gap-3 text-white">
                <h3 className="text-2xl sm:text-3xl font-serif tracking-wide">
                  {isEN ? s.titleEN : s.titleFR}
                </h3>
                <p className="text-sm sm:text-base text-white/80">
                  {isEN ? s.subEN : s.subFR}
                </p>
                <div className="mt-2 flex flex-wrap gap-2">
                  {(isEN ? s.kwEN : s.kwFR).map(k => <span key={k} className="badge">{k}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  );
}
