import React from "react";
import { services } from "../data/services";

function ServiceCard({ item, lang = "fr" }) {
  const t = (o) => (o?.[lang] ?? o?.fr ?? "");
  const kw = item.keywords?.[lang] ?? [];
  return (
    <div
      className="group relative overflow-hidden rounded-2xl shadow-lg ring-1 ring-white/10 bg-black/40"
      style={{
        backgroundImage: `url(${item.image})`,
        backgroundSize: "cover",
        backgroundPosition: "center"
      }}
    >
      <div className="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />
      <div className="relative p-6 sm:p-8 flex flex-col gap-3 text-white">
        <h3 className="text-2xl sm:text-3xl font-serif tracking-wide">
          {t(item.title)}
        </h3>
        <p className="text-sm sm:text-base text-white/80">{t(item.subtitle)}</p>
        <div className="mt-2 flex flex-wrap gap-2 text-[12px] sm:text-xs uppercase tracking-wider">
          {kw.map((k) => (
            <span
              key={k}
              className="px-2 py-1 rounded-full bg-white/10 backdrop-blur-sm ring-1 ring-white/20"
            >
              {k}
            </span>
          ))}
        </div>
      </div>
    </div>
  );
}

export default function ServicesGrid({ lang = "fr" }) {
  return (
    <section className="py-12 sm:py-20">
      <div className="container mx-auto px-4">
        <header className="mb-8 sm:mb-12">
          <h2 className="text-3xl sm:text-4xl font-serif text-white">
            {lang === "en" ? "Our Services" : "Nos Services"}
          </h2>
          <p className="text-white/70 mt-2">
            {lang === "en"
              ? "Tailor-made experiences with our signature direction."
              : "Des expériences sur-mesure, signées par notre direction artistique."}
          </p>
        </header>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {services.map((s) => (
            <ServiceCard key={s.id} item={s} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  );
}
