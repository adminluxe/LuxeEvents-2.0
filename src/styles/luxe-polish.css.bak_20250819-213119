:root { --gold:#D4AF37; --ink:#E7E7E7; --muted:#B8B8B8; }
section#services h2 { color: var(--ink); letter-spacing:.3px; }
section#services p { color: rgba(231,231,231,.8); }
section#services .badge { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); padding:.28rem .5rem; border-radius:999px; font-size:.72rem; letter-spacing:.08em; }
section#services article { border:1px solid rgba(255,255,255,.08); box-shadow: 0 10px 30px rgba(0,0,0,.25); }
section#trust h2 { color: var(--ink); }
section#trust article { border:1px solid rgba(255,255,255,.10); }
a.cta-link { display:inline-block; margin-right:1rem; }
a.cta-link:last-child { margin-right:0; }
/* Or léger pour titres internes */
section#services h3 { color: var(--ink); }
section#services h3 em, .gold { color: var(--gold); font-style: normal; }
