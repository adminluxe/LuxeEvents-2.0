.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.hero-title{
  font-weight:800; letter-spacing:.4px; line-height:1.1;
  -webkit-text-stroke:1.2px var(--gold);
  -webkit-text-fill-color:var(--ivory);
  color:var(--ivory);
  text-shadow:0 .5px 0 rgba(0,0,0,.25),0 0 28px rgba(212,175,55,.20);
  transition:text-shadow .2s ease, transform .2s ease;
}
.hero-title:hover{ text-shadow:0 1px 0 rgba(0,0,0,.26), 0 0 34px rgba(212,175,55,.35); transform:translateY(-0.5px); }
html:not(.dark) .hero-title{
  -webkit-text-stroke:1.1px #1a1a1a;
  -webkit-text-fill-color:var(--gold);
  color:var(--gold);
  text-shadow:0 .5px 0 rgba(0,0,0,.30),0 0 24px rgba(212,175,55,.22);
}
html:not(.dark) .hero-title:hover{ text-shadow:0 1px 0 rgba(0,0,0,.32), 0 0 28px rgba(212,175,55,.35); }
@supports not (-webkit-text-stroke:1px black){
  .hero-title{ color:var(--ivory);
    text-shadow:1px 0 0 var(--gold),-1px 0 0 var(--gold),0 1px 0 var(--gold),0 -1px 0 var(--gold),0 .5px 0 rgba(0,0,0,.25); }
  html:not(.dark) .hero-title{ color:var(--gold);
    text-shadow:1px 0 0 #1a1a1a,-1px 0 0 #1a1a1a,0 1px 0 #1a1a1a,0 -1px 0 #1a1a1a,0 .5px 0 rgba(0,0,0,.30); }
}
