:root{
  --gold-1:#C9A227; --gold-2:#E6C767; --gold-3:#F3E6A6;
  --bg-dark:#0b0b0b; --bg-light:#ffffff;
}
html.dark{ color-scheme: dark; }

.text-gold{ color: var(--gold-2); }
.bg-gold{ background: radial-gradient(60% 60% at 50% 40%, var(--gold-3), var(--gold-2) 45%, var(--gold-1) 100%); }
.border-gold{ border-color: rgba(201,162,39,.6); }

.btn-gold{
  position:relative; display:inline-flex; align-items:center; gap:.5rem;
  padding:.8rem 1.2rem; border-radius:1rem; border:1px solid rgba(201,162,39,.35);
  background: linear-gradient(180deg, rgba(255,255,255,.7), rgba(255,255,255,.35)) padding-box,
              radial-gradient(100% 100% at 0 0, rgba(255,255,255,.8), rgba(201,162,39,.55)) border-box;
  box-shadow: 0 10px 30px rgba(201,162,39,.15), inset 0 1px 0 rgba(255,255,255,.5);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
}
.btn-gold:hover{ transform: translateY(-1px); box-shadow: 0 14px 40px rgba(201,162,39,.22), inset 0 1px 0 rgba(255,255,255,.6); }
.btn-gold:active{ transform: translateY(0); }

.halo{
  position:relative;
}
.halo:before{
  content:""; position:absolute; inset:-20%; border-radius:999px; z-index:-1;
  background: radial-gradient(60% 60% at 50% 50%, rgba(243,230,166,.35), rgba(230,199,103,.12), rgba(11,11,11,0) 70%);
  filter: blur(18px); pointer-events:none;
}

.ripple{ position:relative; overflow:hidden; }
.ripple:after{
  content:""; position:absolute; width:20px; height:20px; top:var(--y,50%); left:var(--x,50%);
  transform: translate(-50%,-50%) scale(0);
  background: radial-gradient(circle closest-side, rgba(255,255,255,.8), rgba(255,255,255,0));
  border-radius: 999px; opacity:.8; pointer-events:none;
  animation: ripple .6s ease-out;
}
@keyframes ripple{ to{ transform: translate(-50%,-50%) scale(18); opacity:0; } }

@supports (padding:max(0px)) {
  .safe-pad{ padding-right: max(1rem, env(safe-area-inset-right));
             padding-left:  max(1rem, env(safe-area-inset-left));
             padding-bottom:max(1rem, env(safe-area-inset-bottom)); }
}

/* h1 default fix */
section h1#force-hero-h1{
  font-size: clamp(28px, 4vw, 48px);
  line-height: 1.15;
  margin: .6em 0 .4em;
}
