import React from "react";
import { Link } from "react-router-dom";

/**
 * PrimaryCTA — source de vérité unique pour tous les CTA principaux.
 *
 * Variants:
 * - hero: gros bouton immersif (full width possible)
 * - nav: compact, navbar
 * - dock: compact, bottom/dock
 *
 * Props:
 * - to: route (default: "/devis")
 * - label: texte (default: "Demander un devis")
 * - variant: "hero" | "nav" | "dock"
 * - className: override/add Tailwind
 * - onClick: handler optionnel
 */
export default function PrimaryCTA({
  to = "/devis",
  label = "Demander un devis",
  variant = "hero",
  className = "",
  onClick,
}) {
  const base =
    "inline-flex items-center justify-center rounded-full font-medium text-black " +
    "bg-[#D4AF37] transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF37]/60";

  const variants = {
    hero:
      "w-full px-7 py-3.5 text-sm sm:text-base " +
      "shadow-[0_18px_70px_rgba(212,175,55,0.22)] hover:shadow-[0_24px_90px_rgba(212,175,55,0.33)]",
    nav:
      "px-4 sm:px-5 py-2.5 text-sm " +
      "shadow-[0_14px_50px_rgba(212,175,55,0.18)] hover:shadow-[0_20px_70px_rgba(212,175,55,0.28)]",
    dock:
      "px-5 py-3 text-sm " +
      "shadow-[0_18px_70px_rgba(212,175,55,0.22)] hover:shadow-[0_24px_90px_rgba(212,175,55,0.33)]",
  };

  const arrow = <span className="ml-2 opacity-80">→</span>;

  // mini hook tracking (safe)
  const handleClick = (e) => {
    try {
      // Exemple : window.dataLayer push si GA
      // window.dataLayer?.push({ event: "primary_cta_click", variant, to });
    } catch (_) {}
    onClick?.(e);
  };

  return (
    <Link
      to={to}
      onClick={handleClick}
      className={[base, variants[variant] || variants.hero, className].join(" ").trim()}
      aria-label={label}
    >
      {label}
      {arrow}
    </Link>
  );
}
