# Keep both values empty for the safe preview mode: the brief is copied locally.
# Configure exactly one validated channel before public launch.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=

# Mandatory public legal identity for the Luxembourg launch.
# VITE_LEGAL_NAME must identify the legal publisher that exists on launch day.
# Do not use the name of a company that is still being incorporated as if it
# were already registered.
VITE_LEGAL_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
VITE_PRIVACY_EMAIL=
VITE_CONTACT_RETENTION_MONTHS=
