#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🛑 Vérification des échappements interdits dans JSX..."

if grep -r '\\[a-zA-Z0-9]\+-' src/*.jsx src/*.tsx | grep -q '\\'; then
  echo "❌ Échappement interdit trouvé (\\w-, \\h-, etc.). Corrige avant de push !"
  exit 1
fi

echo "✅ Aucun échappement interdit détecté."
